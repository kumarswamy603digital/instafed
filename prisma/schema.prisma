// Prisma schema for InstaFed
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String?
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  subscriptions Subscription[]
  sections      Section[]
}

model Subscription {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Instagram account details captured at subscribe time.
  igUsername   String
  igFullName   String?
  igProfilePic String?
  igIsVerified Boolean  @default(false)
  igIsPrivate  Boolean  @default(false)

  createdAt    DateTime @default(now())

  sectionLinks SectionChannel[]

  // A user can only subscribe to a given handle once.
  @@unique([userId, igUsername])
  @@index([userId])
}

// A user-defined category that groups a subset of their subscribed channels.
model Section {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  position  Int              @default(0)
  createdAt DateTime         @default(now())

  channels  SectionChannel[]

  @@index([userId])
}

// Join table: which subscriptions belong to which section (many-to-many).
model SectionChannel {
  id             String       @id @default(cuid())
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, subscriptionId])
  @@index([sectionId])
  @@index([subscriptionId])
}
