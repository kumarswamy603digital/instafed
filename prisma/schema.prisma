// Prisma schema for InstaFed
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String?
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  subscriptions Subscription[]
  sections      Section[]
  playlists     Playlist[]
  pinned        PinnedVideo[]
  history       HistoryItem[]
}

model Subscription {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Instagram account details captured at subscribe time.
  igUsername   String
  igFullName   String?
  igProfilePic String?
  igIsVerified Boolean  @default(false)
  igIsPrivate  Boolean  @default(false)

  createdAt    DateTime @default(now())

  sectionLinks SectionChannel[]

  // A user can only subscribe to a given handle once.
  @@unique([userId, igUsername])
  @@index([userId])
}

// A user-defined category that groups a subset of their subscribed channels.
model Section {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  position  Int              @default(0)
  createdAt DateTime         @default(now())

  channels  SectionChannel[]

  @@index([userId])
}

// Join table: which subscriptions belong to which section (many-to-many).
model SectionChannel {
  id             String       @id @default(cuid())
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, subscriptionId])
  @@index([sectionId])
  @@index([subscriptionId])
}


// A user-defined playlist collecting videos across channels.
model Playlist {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  position  Int            @default(0)
  createdAt DateTime       @default(now())

  items     PlaylistItem[]

  @@index([userId])
}

// A saved video inside a playlist. Because videos come from Apify (not stored
// in our DB), we snapshot the fields we need to render the card offline.
model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  // Video snapshot
  videoKey        String // IgVideo.id — used to dedupe within a playlist
  shortCode       String?
  url             String
  caption         String?
  thumbnailUrl    String?
  videoUrl        String?
  durationSeconds Float?
  viewsCount      Float?
  likesCount      Float?
  commentsCount   Float?
  timestamp       String?

  // Channel snapshot
  channelUsername   String
  channelFullName   String?
  channelProfilePic String?
  channelIsVerified Boolean @default(false)

  addedAt DateTime @default(now())

  @@unique([playlistId, videoKey])
  @@index([playlistId])
}


// A video the user pinned. Snapshots the video + channel like PlaylistItem.
model PinnedVideo {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  videoKey        String
  shortCode       String?
  url             String
  caption         String?
  thumbnailUrl    String?
  videoUrl        String?
  durationSeconds Float?
  viewsCount      Float?
  likesCount      Float?
  commentsCount   Float?
  timestamp       String?

  channelUsername   String
  channelFullName   String?
  channelProfilePic String?
  channelIsVerified Boolean @default(false)

  pinnedAt DateTime @default(now())

  @@unique([userId, videoKey])
  @@index([userId])
}

// A watched-video history entry. Re-watching updates watchedAt.
model HistoryItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  videoKey        String
  shortCode       String?
  url             String
  caption         String?
  thumbnailUrl    String?
  videoUrl        String?
  durationSeconds Float?
  viewsCount      Float?
  likesCount      Float?
  commentsCount   Float?
  timestamp       String?

  channelUsername   String
  channelFullName   String?
  channelProfilePic String?
  channelIsVerified Boolean @default(false)

  watchedAt DateTime @default(now())

  @@unique([userId, videoKey])
  @@index([userId])
}
