# ---------------------------------------------------------------------------
# InstaFed environment configuration
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------------------

# Database (SQLite by default; file lives at prisma/dev.db)
DATABASE_URL="file:./dev.db"

# NextAuth - session encryption secret.
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Apify - Instagram scraping
# ---------------------------------------------------------------------------
# Your Apify API token (Apify Console -> Settings -> Integrations).
APIFY_TOKEN=""

# Actor used for both search and post scraping. Default is the official actor.
APIFY_ACTOR_ID="apify~instagram-scraper"

# How many search results to return per query.
APIFY_SEARCH_LIMIT="20"

# How many videos to fetch per account. Leave empty (or "0" / "unlimited" /
# "all") to fetch EVERY video for the account. Set a positive number to cap it.
APIFY_VIDEOS_LIMIT=""

# Set to "true" to bypass Apify and use built-in mock data (great for local UI
# development without spending Apify credits). If APIFY_TOKEN is empty the app
# automatically falls back to mock mode as well.
MOCK_APIFY="false"

# ---------------------------------------------------------------------------
# OCR.space - read Instagram account details from a pasted/uploaded screenshot
# ---------------------------------------------------------------------------
# Get a free key at https://ocr.space/ocrapi. The public demo key "helloworld"
# works for light testing but is heavily rate-limited — use your own key.
OCRSPACE_API_KEY=""

# ---------------------------------------------------------------------------
# Video provider — how InstaFed fetches an account's videos/reels
# ---------------------------------------------------------------------------
# "apify"  (default) — uses the Apify actor configured above.
# "ytdlp"           — uses a local yt-dlp binary + your Instagram cookies.
VIDEO_PROVIDER="apify"

# --- yt-dlp settings (only used when VIDEO_PROVIDER="ytdlp") ---
# Requires yt-dlp installed on the machine running the app:  pip install -U yt-dlp
#
# Option A: a Netscape-format cookies.txt exported from a logged-in IG session
# (use the "Get cookies.txt LOCALLY" browser extension), e.g. ./cookies.txt
IG_COOKIES_PATH=""
# Option B: pull cookies straight from your logged-in browser instead of a file
# (chrome | firefox | edge | brave | opera | vivaldi). Leave IG_COOKIES_PATH empty.
IG_COOKIES_FROM_BROWSER=""
# Optional: custom path to the yt-dlp binary (defaults to "yt-dlp" on PATH)
YTDLP_PATH="yt-dlp"
# Max reels to list per account (0 = all)
YTDLP_VIDEOS_LIMIT="0"
